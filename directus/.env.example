# Copy to .env and fill in real values. .env is gitignored.
# Used by docker-compose.yaml interpolation.

# Directus license key (Innovation Grant)
LICENSE_KEY=

# Directus encryption key + JWT secret
# KEY encrypts sensitive data in the DB — keep it with your DB backups.
KEY=
SECRET=

# Admin bootstrap / static token
ADMIN_TOKEN=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Postgres
POSTGRES_USER=directus
POSTGRES_PASSWORD=
POSTGRES_DB=directus
